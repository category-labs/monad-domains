{
  "name": "@domain-bridging/prover",
  "version": "0.1.0",
  "private": true,
  "description": "Off-chain tooling for Monad domains: domain setup, encrypted sequencing, viewing keys, validator checkpoints, message proofs and delivery tracking",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "setup": "tsx src/setup-cli.ts",
    "sequence": "tsx src/sequence-cli.ts",
    "checkpoint": "tsx src/checkpoint-cli.ts",
    "viewing-key": "tsx src/viewing-key-cli.ts",
    "e2e": "tsx e2e/e2e-cli.ts",
    "e2e:routing": "tsx e2e/e2e-routing-cli.ts"
  },
  "dependencies": {
    "@hpke/core": "^1.9.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
