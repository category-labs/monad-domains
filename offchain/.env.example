# Copy to .env, fill in the values, then load it before running a command:
#   cd offchain
#   cp .env.example .env         # then edit .env
#   set -a && source .env && set +a
#   npm run setup                # one-time: bring up the domain
#   npm run sequence             # submit one domain transaction through the hub
#   npm run relayer              # keep running: attest checkpoints and relay domain -> L1 messages
#
# The first block configures `npm run setup`; the second block configures `npm run sequence`.
# L1_RPC_URL, DOMAIN_CHAIN_ID, SEQUENCING_FEE, and VIEWING_KEY are shared by both.

# =====================================================================
# npm run setup
# =====================================================================

# --- Required ---

# L1 JSON-RPC endpoint where the hub, L1Bridge, and the sequencing transactions are submitted.
L1_RPC_URL=

# Key that deploys DomainHub + L1Bridge and calls registerDomain. Becomes the L1Bridge
# owner and — unless overridden — the domain seed deployer and the fee recipient too.
ADMIN_KEY=

# Chain id of the domain. Must differ from the L1 chain id.
DOMAIN_CHAIN_ID=7777

# Comma-separated validator addresses — the set whose signatures attest domain state transitions.
VALIDATORS=

# Distinct validator signatures required to advance the state (1 <= QUORUM <= number of validators).
QUORUM=

# --- Optional (each has a default; uncomment to override) ---

# Add this domain to an existing routing-capable hub. Domains must share a hub to
# exchange native messages. Omit for the first domain to deploy a new hub.
# EXISTING_HUB_ADDRESS=

# Domain account whose first two transactions (nonce 0, 1) create the spoke and bridge. Defaults to
# ADMIN_KEY. If set to a separate account, it must have no prior domain activity.
# SEED_DEPLOYER_KEY=

# Receives the wei forwarded with every sequenceToDomain call. Defaults to the admin address.
# FEE_RECIPIENT=

# Validators attest the domain state at L1 heights that are multiples of this interval, so
# independent validators converge on the same checkpoint without coordinating. Default: 5.
# CHECKPOINT_INTERVAL=5

# Existing L1 ERC20 to allowlist for deposits (e.g. wrapped MON). Default: none.
# ALLOWED_TOKEN=

# Wei forwarded to the fee recipient with each sequenced transaction (the L1 msg.value). Default: 0.
# SEQUENCING_FEE=0

# Gas limit stamped inside the seeded domain creation transactions. Default: 5000000.
# DOMAIN_GAS=5000000

# Domain viewing public key: the 65-byte uncompressed P-256 point (0x04...) matching the PEM the
# Domain execution client was started with (`--private-domain <id> <spoke> <key.pem>`). Print it from
# that PEM with `npm run viewing-key -- public <key.pem>`, or create both with
# `npm run viewing-key -- generate <key.pem>`. When set, every sequenced transaction (the seeded
# creations here and `npm run sequence`) is HPKE-encrypted to it and the client decrypts before
# executing. `npm run setup` also publishes it on the hub, where `npm run sequence` reads it back
# when this variable is unset. A node running with a receiver key drops plaintext payloads, so set
# this whenever the node has one. Default: none (plaintext, nothing published).
# VIEWING_KEY=0x04...

# =====================================================================
# npm run sequence  (submit one domain transaction)
# =====================================================================

# --- Required ---

# The DomainHub address on the L1 (printed by `npm run setup`).
# HUB_ADDRESS=

# Key that signs the domain transaction and submits sequenceToDomain on the L1.
# SENDER_KEY=

# The domain nonce is required unless DOMAIN_RPC_URL is set (then it is fetched). Provide one:
# TX_NONCE=0
# DOMAIN_RPC_URL=

# --- Optional ---

# Domain target address. Omit for a contract creation. Default: none (creation).
# TO=

# Domain calldata. Default: 0x.
# DATA=0x

# Domain native value in wei. Default: 0 (domains here have no native gas token — use wrapped MON).
# VALUE=0

# Domain gas limit stamped on the transaction. Default: 1000000.
# GAS=1000000

# =====================================================================
# npm run checkpoint  (one validator pass: attest the next scheduled checkpoint)
# =====================================================================

# --- Required ---

# The DomainHub address on the L1 (printed by `npm run setup`).
# HUB_ADDRESS=

# The DomainSpoke address on the domain (printed by `npm run setup`, CREATE(seed, 0)).
# SPOKE_ADDRESS=

# Comma-separated validator keys that sign the checkpoint. Each validator normally runs this
# with its own single key; the hub advances once a quorum signed the same proposal.
# VALIDATOR_KEYS=

# L1 account that pays for the submitStateSignature transactions.
# SUBMITTER_KEY=

# --- Optional ---

# Domain JSON-RPC route. Default: `${L1_RPC_URL}/domain/${DOMAIN_CHAIN_ID}`.
# DOMAIN_RPC_URL=

# Attest this exact L1 height (must be on the schedule and finalized) instead of the latest
# scheduled height below the finalized L1 block.
# CHECKPOINT_HEIGHT=

# =====================================================================
# npm run relayer  (long-running: attest checkpoints and relay domain -> L1 messages)
# =====================================================================
#
# The domain protocol delivers L1 -> domain messages by itself. The other direction needs
# validator signatures and a prover, and this service provides both for every domain in
# RELAYER_DOMAINS: once the L1 has finalized a new scheduled height it signs the checkpoint
# (domain state root plus the root of the messages recorded since the hub's previous
# checkpoint) with the configured validator keys and submits it, then rebuilds every attested
# batch and proves its messages to hub.relayDomainMessage. It attests as soon as messages
# wait and otherwise every ATTEST_INTERVAL_MS. L1_RPC_URL, HUB_ADDRESS and SUBMITTER_KEY
# above are shared with `npm run checkpoint`.

# --- Required ---

# Comma-separated chain ids of the domains to serve. Each has its own RELAYER_<id>_* block.
# RELAYER_DOMAINS=85679

# The DomainSpoke on that domain.
# RELAYER_85679_SPOKE=

# Comma-separated keys of registered validators whose signatures this service submits.
# The hub advances once QUORUM distinct validators have signed the same checkpoint.
# RELAYER_85679_VALIDATOR_KEYS=

# --- Optional ---

# Domain JSON-RPC endpoint. Default: $L1_RPC_URL/domain/85679.
# RELAYER_85679_DOMAIN_RPC_URL=

# L1 block to scan the hub's attestations from; at or before the domain's first attestation,
# e.g. the block the domain was registered in. Default: 0.
# RELAYER_85679_START_BLOCK=0

# Delay between passes over the domains, in milliseconds. Default: 2000.
# POLL_INTERVAL_MS=2000

# Attest the latest finalized scheduled height even without new messages once this long has
# passed since the last attestation, in milliseconds. 0 attests only for messages. Default: 60000.
# ATTEST_INTERVAL_MS=60000

# Largest block range one eth_getLogs call may span. Default: 1000.
# LOG_RANGE=1000
