# Copy to .env, fill in the values, then load it before running a command:
#   cd offchain
#   cp .env.example .env         # then edit .env
#   set -a && source .env && set +a
#   npm run setup                # one-time: bring up the domain
#   npm run sequence             # submit one domain transaction through the hub
#
# The first block configures `npm run setup`; the second block configures `npm run sequence`.
# L1_RPC_URL, DOMAIN_CHAIN_ID and ENCRYPTION_PUB_KEY are shared by both. Every sequenced transaction
# costs `gas limit * hub.DOMAIN_GAS_PRICE()` wei on the L1, paid to the domain's fee recipient.

# =====================================================================
# npm run setup
# =====================================================================

# --- Required ---

# L1 JSON-RPC endpoint where the hub, L1Bridge, and the sequencing transactions are submitted.
L1_RPC_URL=

# Key that deploys DomainHub + L1Bridge and calls registerDomain. Becomes the L1Bridge
# owner and — unless overridden — the hub owner, the domain seed deployer and the fee
# recipient too.
ADMIN_KEY=

# Chain id of the domain: 64 bits whose low 16 bits are the L1 chain id, e.g. (1 << 16) | 20143
# = 85679 on the devnet. The execution client refuses any other.
DOMAIN_CHAIN_ID=85679

# Comma-separated validator addresses — the set whose signatures attest domain state transitions.
VALIDATORS=

# Distinct validator signatures required to advance the state (1 <= QUORUM <= number of validators).
QUORUM=

# --- Optional (each has a default; uncomment to override) ---

# Register this domain on an existing hub instead of deploying one. Domains must share a hub
# to message each other. Omit for the first domain.
# EXISTING_HUB_ADDRESS=

# Account that may upgrade the hub deployed here. Defaults to the admin address. Unused with
# EXISTING_HUB_ADDRESS.
# HUB_OWNER=

# Domain account whose first transactions create the optional policy and the bridge. Defaults to
# ADMIN_KEY. If set to a separate account, it must have no prior domain activity.
# SEED_DEPLOYER_KEY=

# Receives the fee of every sequencing and message call. Defaults to the admin address.
# FEE_RECIPIENT=

# Validators attest the domain state at L1 heights that are multiples of this interval, so
# independent validators converge on the same checkpoint without coordinating. Default: 5.
# CHECKPOINT_INTERVAL=5

# Domain administrator of all bridged-token access policies; defaults to ADMIN_KEY's address.
# TOKEN_POLICY_OWNER=0x...
# Existing policy contract on the domain; omit to deploy DomainAccessRules.
# Unconfigured selectors are open; the policy owner must configure each token's read rules.
# INITIAL_TOKEN_POLICY=0x...

# Existing L1 ERC20 to allowlist for deposits (e.g. wrapped MON). Default: none.
# ALLOWED_TOKEN=

# Gas limit stamped inside the seeded domain creation transactions, paid for on the L1 at
# DOMAIN_GAS_PRICE. Default: 5000000.
# DOMAIN_GAS=5000000

# Domain encryption public key: the 32-byte X25519 public key matching the PEM the
# Domain execution client was started with (`monad-domain --domain <id> <key.pem>`). Print it from
# that PEM with `npm run encryption-key -- public <key.pem>`, or create both with
# `npm run encryption-key -- generate <key.pem>`. When set, every sequenced transaction (the seeded
# creations here and `npm run sequence`) is HPKE-encrypted to it and the client decrypts before
# executing. `npm run setup` also publishes it on the hub, where `npm run sequence` reads it back
# when this variable is unset. `npm run sequence` rejects a missing key.
# ENCRYPTION_PUB_KEY=0x...

# =====================================================================
# npm run sequence  (submit one domain transaction)
# =====================================================================

# --- Required ---

# The DomainHub address on the L1 (printed by `npm run setup`).
# HUB_ADDRESS=

# Key that signs the domain transaction and submits sequenceToDomain on the L1.
# SENDER_KEY=

# The domain nonce is required unless DOMAIN_RPC_URL is set (then it is fetched). Provide one:
# TX_NONCE=0
# DOMAIN_RPC_URL=

# --- Optional ---

# Domain target address. Omit for a contract creation. Default: none (creation).
# TO=

# Domain calldata. Default: 0x.
# DATA=0x

# Domain native value in wei. Default: 0 (domains here have no native gas token — use wrapped MON).
# VALUE=0

# Domain gas limit stamped on the transaction; the L1 fee is GAS * DOMAIN_GAS_PRICE. Default: 1000000.
# GAS=1000000

# =====================================================================
# npm run checkpoint  (one validator pass: attest the next scheduled checkpoint)
# =====================================================================

# --- Required ---

# The DomainHub address on the L1 (printed by `npm run setup`).
# HUB_ADDRESS=

# The DomainSpoke address on the domain. Default: the spoke in the domain's genesis state.
# SPOKE_ADDRESS=

# Key of an operator of the domain's RPC: signs the access token every request carries. The
# RPC serves blocks and the spoke's logs to operators only.
# DOMAIN_RPC_KEY=

# Comma-separated validator keys that sign the checkpoint. Each validator normally runs this
# with its own single key; the hub advances once a quorum signed the same proposal.
# VALIDATOR_KEYS=

# L1 account that pays for the submitStateSignature transactions.
# SUBMITTER_KEY=

# The domain's JSON-RPC endpoint: an RPC serving the domain's own chain
# (`monad-rpc --domain-chain-id <id> --triedb-path <the domain client's db>`).
# DOMAIN_RPC_URL=

# --- Optional ---

# Keep running: attest every checkpoint that is due, then look again after this many
# milliseconds. Default: a single pass.
# POLL_INTERVAL_MS=

# Attest this exact L1 height (must be on the schedule and finalized) instead of the next
# scheduled height above the hub's last attested one.
# CHECKPOINT_HEIGHT=

# =====================================================================
# npm run relay  (prove attested domain messages to the hub)
# =====================================================================

# --- Required: HUB_ADDRESS, DOMAIN_RPC_URL and DOMAIN_RPC_KEY as for `npm run checkpoint`, and ---

# L1 account that pays for the relayDomainMessage transactions.
# RELAYER_KEY=

# --- Optional ---

# L1 block at or before the domain's first attestation, e.g. the one that registered it. Default: 0.
# SCAN_FROM_BLOCK=

# Gas bought for the delivery of each message forwarded to another domain. Default: 500000.
# DELIVERY_GAS=

# Keep running, one pass per this many milliseconds. Default: a single pass.
# POLL_INTERVAL_MS=
