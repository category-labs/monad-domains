# Copy to .env, fill in the values, then load it before running a command:
#   cd offchain
#   cp .env.example .env         # then edit .env
#   set -a && source .env && set +a
#   npm run setup                # one-time: bring up the domain
#   npm run sequence             # submit one domain transaction through the hub
#   npm run relayer              # keep running: finalize, attest and relay domain -> L1 messages
#
# The first block configures `npm run setup`, the second `npm run sequence`, the third
# `npm run relayer`. L1_RPC_URL, DOMAIN_CHAIN_ID, SEQUENCING_FEE, and VIEWING_KEY are shared.

# =====================================================================
# npm run setup
# =====================================================================

# --- Required ---

# L1 JSON-RPC endpoint where the hub, L1Bridge, and the sequencing transactions are submitted.
L1_RPC_URL=

# Key that deploys DomainHub + L1Bridge and calls registerDomain. Becomes the domain
# operator (fee recipient, domain batch finalizer), the L1Bridge owner, and — unless
# overridden — the domain seed deployer and spoke operator too.
ADMIN_KEY=

# Chain id of the domain. Must differ from the L1 chain id.
DOMAIN_CHAIN_ID=7777

# Comma-separated validator addresses — the set whose signatures attest domain state transitions.
VALIDATORS=

# Distinct validator signatures required to advance the state (1 <= QUORUM <= number of validators).
QUORUM=

# --- Optional (each has a default; uncomment to override) ---

# Add this domain to an existing routing-capable hub. Domains must share a hub to
# exchange native messages. Omit for the first domain to deploy a new hub.
# EXISTING_HUB_ADDRESS=

# Domain account whose first two transactions (nonce 0, 1) create the spoke and bridge. Defaults to
# ADMIN_KEY. If set to a separate account, it must have no prior domain activity.
# SEED_DEPLOYER_KEY=

# Register the domain on an already deployed hub instead of deploying a new one. One hub
# serves any number of domains. Default: deploy a new hub.
# HUB_ADDRESS=

# Address recorded as OPERATOR on the spoke (finalizes domain -> L1 message batches; the
# relayer below sequences those from RELAYER_<id>_OPERATOR_KEY). Defaults to the admin address.
# SPOKE_OPERATOR=

# Existing L1 ERC20 to allowlist for deposits (e.g. wrapped MON). Default: none.
# ALLOWED_TOKEN=

# Wei forwarded to the operator with each sequenced transaction (the L1 msg.value). Default: 0.
# SEQUENCING_FEE=0

# Gas limit stamped inside the seeded domain creation transactions. Default: 5000000.
# DOMAIN_GAS=5000000

# Domain viewing public key: the 65-byte uncompressed P-256 point (0x04...) matching the PEM the
# Domain execution client was started with (`--private-domain <id> <spoke> <key.pem>`). Print it from
# that PEM with `npm run viewing-key -- public <key.pem>`, or create both with
# `npm run viewing-key -- generate <key.pem>`. When set, every sequenced transaction (the seeded
# creations here and `npm run sequence`) is HPKE-encrypted to it and the client decrypts before
# executing. A node running with a receiver key drops plaintext payloads, so set this whenever the
# node has one. Default: none (plaintext).
# VIEWING_KEY=0x04...

# =====================================================================
# npm run sequence  (submit one domain transaction)
# =====================================================================

# --- Required ---

# The DomainHub address on the L1 (printed by `npm run setup`).
# HUB_ADDRESS=

# Key that signs the domain transaction and submits sequenceToDomain on the L1.
# SENDER_KEY=

# The domain nonce is required unless DOMAIN_RPC_URL is set (then it is fetched). Provide one:
# TX_NONCE=0
# DOMAIN_RPC_URL=

# --- Optional ---

# Domain target address. Omit for a contract creation. Default: none (creation).
# TO=

# Domain calldata. Default: 0x.
# DATA=0x

# Domain native value in wei. Default: 0 (domains here have no native gas token — use wrapped MON).
# VALUE=0

# Domain gas limit stamped on the transaction. Default: 1000000.
# GAS=1000000

# =====================================================================
# npm run relayer  (long-running: finalize, attest and relay domain -> L1 messages)
# =====================================================================
#
# The domain protocol delivers L1 -> domain messages by itself. The other direction needs
# keys on the domain side, and this service holds them: for every domain in RELAYER_DOMAINS
# it sequences spoke.finalizeDomainMessages() from the operator whenever messages are pending,
# signs the state transition (latest committed domain header + batch anchor) with the
# configured validators and submits it to the hub, and proves every finalized message to
# hub.relayDomainMessage. With nothing pending it still attests the latest domain header
# every ATTEST_INTERVAL_MS so the hub's commitment keeps up with the domain.

# --- Required ---

# The DomainHub address on the L1.
# HUB_ADDRESS=

# L1 account that pays for submitStateSignature and relayDomainMessage. Any funded key.
# SUBMITTER_KEY=

# Comma-separated chain ids of the domains to serve. Each has its own RELAYER_<id>_* block.
# RELAYER_DOMAINS=85679

# The DomainSpoke on that domain.
# RELAYER_85679_SPOKE=

# Key of the spoke OPERATOR (SPOKE_OPERATOR above); signs and sequences finalizeDomainMessages.
# RELAYER_85679_OPERATOR_KEY=

# Comma-separated keys of registered validators whose signatures this service submits.
# The hub advances once QUORUM distinct validators have signed the same transition.
# RELAYER_85679_VALIDATOR_KEYS=

# --- Optional ---

# Domain viewing public key; encrypts the sequenced finalize transaction. Set it whenever the
# node runs with a receiver key for the domain. Default: plaintext.
# RELAYER_85679_VIEWING_KEY=0x04...

# Domain JSON-RPC endpoint. Default: $L1_RPC_URL/domain/85679.
# RELAYER_85679_DOMAIN_RPC_URL=

# First domain block to index spoke events from (e.g. the block the hub was deployed in).
# Default: 0.
# RELAYER_85679_START_BLOCK=0

# Delay between passes over the domains, in milliseconds. Default: 2000.
# POLL_INTERVAL_MS=2000

# How often to attest the latest domain header while nothing is pending, in milliseconds.
# 0 disables idle attestations. Default: 60000.
# ATTEST_INTERVAL_MS=60000

# How long one pass waits for a batch's finalize block to become finalized before attesting
# it, in milliseconds, instead of attesting on a later pass. Default: 5000.
# FINALITY_WAIT_MS=5000
